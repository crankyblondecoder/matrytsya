						"$ref": "#/components/responses/Internal"
					},
					"404": {
						"$ref": "#/components/responses/NotFound"
					}
				}
			},
			"patch": {
				"operationId": "updateNode",
				"tags": [
					"Nodes"
				],
				"summary": "Edit a node",
				"description": "Changes some of a node's fields. Each top level field given replaces that field of the node's current definition (as `getNode` returns it); fields not given are kept. The node is then rebuilt from the result and put in place of the old one, keeping every edge to and from it and any strobe emitter registration.\n\nGiving `edges` replaces every edge leaving the node; edges into it are always kept. A node's `name` and `type` cannot be changed. A node a surface is bound to cannot be edited while the hive runs.\n\nA node's runtime state, such as what its script has done since it joined, is not carried over: the rebuilt node starts afresh.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"description": "Top level fields of the node definition to replace.",
								"additionalProperties": true
							},
							"example": {
								"pokeEnabled": true
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "The edited node.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/NodeView"
								}
							}
						}
					},
					"401": {
						"$ref": "#/components/responses/Unauthorised"
					},
					"429": {
						"$ref": "#/components/responses/RateLimited"
					},
					"500": {
						"$ref": "#/components/responses/Internal"
					},
					"404": {
						"$ref": "#/components/responses/NotFound"
					},
					"400": {
						"$ref": "#/components/responses/BadRequest"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					},
					"415": {
						"$ref": "#/components/responses/UnsupportedMediaType"
					},
					"422": {
						"$ref": "#/components/responses/Unprocessable"
					}
				}
			},
			"delete": {
				"operationId": "deleteNode",
				"tags": [
					"Nodes"
				],
				"summary": "Remove a node",
				"description": "Removes a node from the hive, along with every edge leaving it and every edge from another node into it, and stops it being a strobe emitter. A hive must keep at least one node, and a node a surface is bound to cannot be removed while the hive runs.",
				"responses": {
					"200": {
						"description": "The node was removed.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/NodeDeleted"
								},
								"example": {
									"name": "pinger",
									"deleted": true
								}
							}
						}
					},
					"401": {
						"$ref": "#/components/responses/Unauthorised"
					},
					"429": {
						"$ref": "#/components/responses/RateLimited"
					},
					"500": {
						"$ref": "#/components/responses/Internal"
					},
					"404": {
						"$ref": "#/components/responses/NotFound"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				}
			}
		},
