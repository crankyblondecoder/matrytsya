srcFiles = mongoose.c

objFiles = $(srcFiles:.c=.o)

CC = gcc
CFLAGS = -Wall -O3 -pthread -DMG_ARCH=MG_ARCH_UNIX -DMG_TLS=MG_TLS_BUILTIN

# Tell make to search other paths. Separate multiple with ":"
VPATH = ../../src/mongoose

mongoose.a : $(objFiles)
	@ echo
	@ echo "*** Building - Mongoose Module ***"
	@ echo
	ar rcs mongoose.a $(objFiles)

# Mongoose is a single vendored C file with no dependency tracking. This target exists only so the top
# level "dep" loop does not abort here. See the "dep" target in makefile_std_dep.
.PHONY : dep
dep : ;
