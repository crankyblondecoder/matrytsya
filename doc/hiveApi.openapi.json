					"429": {
						"$ref": "#/components/responses/RateLimited"
					},
					"500": {
						"$ref": "#/components/responses/Internal"
					},
					"404": {
						"$ref": "#/components/responses/NotFound"
					}
				}
			},
			"post": {
				"operationId": "createNode",
				"tags": [
					"Nodes"
				],
				"summary": "Add a node",
				"description": "Adds a node to a running hive. The body is one node, exactly as it would appear in a hive definition's `nodes` array, edges included. Each edge must lead to a node already in the hive, or to the new node itself. To have an existing node lead to the new one, add that edge afterwards with `createEdge`.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "hiveSchema.json#/$defs/node"
							},
							"example": {
								"type": "PingNode",
								"name": "pinger",
								"edges": [
									{
										"toNodeName": "root",
										"actionFlags": [
											"PING_GRAPH_ACTION"
										]
									}
								]
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "The node was added.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/NodeView"
								},
								"example": {
									"name": "pinger",
									"id": 6,
									"type": "PingNode",
									"definition": {
										"type": "PingNode",
										"name": "pinger",
										"pokeEnabled": false,
										"edges": [
											{
												"toNodeName": "root",
												"actionFlags": [
													"PING_GRAPH_ACTION"
												],
												"actionsCompleteAfterTraverse": false,
												"traversalKey": 0
											}
										]
									},
									"edges": [
										{
											"id": 9,
											"to": "root",
											"actionFlags": [
												"PING_GRAPH_ACTION"
											],
											"traversalKey": 0,
											"actionsCompleteAfterTraverse": false
										}
									]
								}
							}
						},
						"headers": {
							"Location": {
								"description": "Path of the new node.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"401": {
						"$ref": "#/components/responses/Unauthorised"
					},
					"429": {
						"$ref": "#/components/responses/RateLimited"
					},
					"500": {
						"$ref": "#/components/responses/Internal"
					},
					"404": {
						"$ref": "#/components/responses/NotFound"
					},
					"400": {
						"$ref": "#/components/responses/BadRequest"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					},
					"415": {
						"$ref": "#/components/responses/UnsupportedMediaType"
					},
					"422": {
						"$ref": "#/components/responses/Unprocessable"
					}
				}
			}
		},
		"/hives/{hive}/nodes/{node}": {
			"parameters": [
				{
					"$ref": "#/components/parameters/hive"
				},
				{
					"$ref": "#/components/parameters/node"
				}
			],
			"get": {
				"operationId": "getNode",
				"tags": [
					"Nodes"
				],
				"summary": "Get a node",
				"description": "Returns a node's full definition and its edges, each with the id `deleteEdge` takes.",
				"responses": {
					"200": {
						"description": "The node.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/NodeView"
								},
								"example": {
									"name": "pinger",
									"id": 6,
									"type": "PingNode",
									"definition": {
										"type": "PingNode",
										"name": "pinger",
										"pokeEnabled": false,
										"edges": [
											{
												"toNodeName": "root",
												"actionFlags": [
													"PING_GRAPH_ACTION"
												],
												"actionsCompleteAfterTraverse": false,
												"traversalKey": 0
											}
										]
									},
									"edges": [
										{
											"id": 9,
											"to": "root",
											"actionFlags": [
												"PING_GRAPH_ACTION"
											],
											"traversalKey": 0,
											"actionsCompleteAfterTraverse": false
										}
									]
								}
							}
						}
					},
					"401": {
						"$ref": "#/components/responses/Unauthorised"
					},
					"429": {
						"$ref": "#/components/responses/RateLimited"
					},
