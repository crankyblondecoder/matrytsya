# Empty recipes for cpp files so they don't cause make to look for implicit rules to build them when they are prerequisites.
$(srcFiles) : ;

%.dep : %.cpp
	@ mkdir -p $$(dirname $@)
    # -MT names the rule's target explicitly. Without it, -MM emits the object's basename (e.g.
    # "ScriptNode.o"), which does not match a subdirectory object like "nodes/ScriptNode.o", so the
    # header prerequisites silently never attach and such objects are never rebuilt when a header changes.
	$(cname) -MM -MT $(@:.dep=.o) $< > $@
	$(cname) -MM -MT $@ $< > $@Make
    # Build the depMake include file.
	@ echo -e "\t\$$(cname) -MM -MT \$$(@:.dep=.o) $$< > \$$@" >> $@Make
	@ echo -e "\t\$$(cname) -MM -MT \$$@ $$< > \$$@Make" >> $@Make

ifneq ($(MAKECMDGOALS),clean)
    include $(objFiles:.o=.dep)
    -include $(objFiles:.o=.depMake)
endif
