	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"description": "An API token the server was started with. Ten failed attempts from one address within a minute lock that address out for the rest of the minute."
			}
		},
		"parameters": {
			"hive": {
				"name": "hive",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string",
					"minLength": 1
				},
				"description": "Name of the hive. URL encode it."
			},
			"node": {
				"name": "node",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string",
					"minLength": 1
				},
				"description": "Name of the node within the hive. URL encode it."
			},
			"surface": {
				"name": "surface",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string",
					"minLength": 1
				},
				"description": "Name of the surface within the hive. URL encode it."
			},
			"edgeId": {
				"name": "edgeId",
				"in": "path",
				"required": true,
				"schema": {
					"type": "integer",
					"minimum": 0
				},
				"description": "Id of the edge, as `getNode` gives it."
			}
		},
		"schemas": {
			"Error": {
				"type": "object",
				"required": [
					"error"
				],
				"additionalProperties": false,
				"description": "Returned with every failure.",
				"properties": {
					"error": {
						"type": "object",
						"required": [
							"code",
							"message"
						],
						"additionalProperties": false,
						"properties": {
							"code": {
								"type": "string",
								"enum": [
									"UNAUTHORISED",
									"RATE_LIMITED",
									"NOT_FOUND",
									"METHOD_NOT_ALLOWED",
									"BAD_REQUEST",
									"UNSUPPORTED_MEDIA_TYPE",
									"CONFLICT",
									"UNPROCESSABLE",
									"INTERNAL"
								],
								"description": "What kind of failure it is, and what to do about it:\n- `UNAUTHORISED` (401): no valid token. Fix the token; do not retry blindly, as failures count towards a lockout.\n- `RATE_LIMITED` (429): too many failed attempts from this address. Wait for `Retry-After` seconds.\n- `NOT_FOUND` (404): the hive, node, surface or edge does not exist. List again to see what does.\n- `METHOD_NOT_ALLOWED` (405): the path exists but not with this method. The `Allow` header lists those it takes.\n- `BAD_REQUEST` (400): the body is missing or not a JSON object. Fix the body.\n- `UNSUPPORTED_MEDIA_TYPE` (415): the body was not sent as `application/json`.\n- `CONFLICT` (409): the request clashes with the hive's current state, e.g. a name already in use, a node a surface is bound to, or the hive's last node. Read the current state, then decide.\n- `UNPROCESSABLE` (422): the body is JSON but describes something invalid, e.g. an unknown node type or action flag. The message says what. Fix the body.\n- `INTERNAL` (500): the server failed. Retrying may help; report it if it persists."
							},
							"message": {
								"type": "string",
								"description": "What went wrong, in words."
							}
						}
					}
				},
				"example": {
					"error": {
						"code": "NOT_FOUND",
						"message": "No node named \"pinger\" is in this hive."
					}
				}
			},
			"ApiIndex": {
				"type": "object",
				"required": [
					"name",
					"version",
					"basePath",
					"openapi",
					"hiveSchema",
					"agentGuide"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"version": {
						"type": "string"
					},
					"basePath": {
						"type": "string",
						"description": "Path every API path is below."
					},
					"openapi": {
						"type": "string",
						"description": "Path of this OpenAPI description."
					},
					"hiveSchema": {
						"type": "string",
						"description": "Path of the hive definition schema."
					},
					"agentGuide": {
						"type": "string",
						"description": "Guide to driving this API, in Markdown, written for AI agents."
					}
				}
			},
			"HiveList": {
				"type": "object",
				"required": [
					"hives"
				],
				"properties": {
					"hives": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/HiveListItem"
						}
					}
				}
			},
			"HiveListItem": {
				"type": "object",
				"required": [
					"name",
					"version",
					"nodeCount"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"version": {
						"$ref": "#/components/schemas/Version"
					},
					"nodeCount": {
						"type": "integer",
						"minimum": 0
					}
				}
			},
			"Version": {
				"type": "integer",
				"minimum": 0,
				"description": "Rises with every structural change to the hive: a node, edge, surface or strobe registration added, removed or changed, by this API or by the hive itself. Compare two readings to tell whether anything changed between them."
			},
			"HiveSummary": {
				"type": "object",
				"required": [
					"name",
					"version",
					"nodeCount",
					"persisted",
					"surfaces",
					"strobeEmitters",
					"strobeSurfaces"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"version": {
						"$ref": "#/components/schemas/Version"
					},
					"nodeCount": {
						"type": "integer",
						"minimum": 0
					},
					"persisted": {
						"type": "boolean",
						"description": "Whether the hive is kept in the hive database."
					},
					"surfaces": {
						"type": "array",
						"description": "Surfaces served, each with the path a browser views it at.",
						"items": {
							"type": "object",
							"required": [
								"name",
								"path"
							],
							"properties": {
								"name": {
									"type": "string"
								},
								"path": {
									"type": "string"
								}
							}
						}
					},
					"strobeEmitters": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/StrobeEmitter"
						}
					},
					"strobeSurfaces": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/StrobeSurface"
						}
					}
				}
			},
			"HiveDeleted": {
				"type": "object",
				"required": [
					"name",
					"deleted",
					"purged"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"deleted": {
						"type": "boolean",
						"description": "Whether a running hive was stopped."
					},
					"purged": {
						"type": "boolean",
						"description": "Whether the hive was deleted from the hive database."
					}
				}
			},
			"NodeList": {
				"type": "object",
				"required": [
					"nodes"
				],
				"properties": {
					"nodes": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/NodeListItem"
						}
					}
				}
			},
			"NodeListItem": {
				"type": "object",
				"required": [
					"name",
					"id",
					"type",
					"edges"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"id": {
						"type": "integer",
						"minimum": 0,
						"description": "Id of the node. Changes when the node is edited."
					},
					"type": {
						"type": "string",
						"description": "Node type, as a hive definition names it, e.g. `PingNode`."
					},
					"edges": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Edge"
						}
					}
				}
			},
			"NodeView": {
				"type": "object",
				"required": [
					"name",
					"id",
					"type",
					"definition",
					"edges"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"id": {
						"type": "integer",
						"minimum": 0,
						"description": "Id of the node. Changes when the node is edited."
					},
					"type": {
						"type": "string",
						"description": "Node type, as a hive definition names it, e.g. `PingNode`."
					},
					"definition": {
						"$ref": "hiveSchema.json#/$defs/node",
						"description": "The node as it was when it joined the hive, with its edges as they are now. This is what `updateNode` edits."
					},
					"edges": {
						"type": "array",
						"description": "Edges leaving the node, with their ids.",
						"items": {
							"$ref": "#/components/schemas/Edge"
						}
					}
				}
			},
			"NodeDeleted": {
				"type": "object",
				"required": [
					"name",
					"deleted"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"deleted": {
						"type": "boolean"
					}
				}
			},
			"ActionFlag": {
				"$ref": "hiveSchema.json#/$defs/actionFlag"
			},
			"Edge": {
				"type": "object",
				"required": [
					"id",
					"to",
					"actionFlags",
					"traversalKey",
					"actionsCompleteAfterTraverse"
				],
				"properties": {
					"id": {
						"type": "integer",
						"minimum": 0,
						"description": "Id of the edge, unique across the server."
					},
					"to": {
						"type": "string",
						"description": "Name of the node the edge leads to."
					},
					"actionFlags": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/ActionFlag"
						},
						"description": "Only actions carrying one of these flags may cross the edge. Empty for any action."
					},
					"traversalKey": {
						"type": "integer",
						"minimum": 0,
						"description": "Only an action holding this key may cross the edge. 0 for no key."
					},
					"actionsCompleteAfterTraverse": {
						"type": "boolean",
						"description": "Whether an action stops after being applied at the node this edge leads to."
					}
				}
			},
			"EdgeCreate": {
				"type": "object",
				"required": [
					"to"
				],
				"additionalProperties": false,
				"properties": {
					"to": {
						"type": "string",
						"minLength": 1,
						"description": "Name of the node the edge leads to."
					},
					"actionFlags": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/ActionFlag"
						},
						"default": []
					},
					"traversalKey": {
						"type": "integer",
						"minimum": 0,
						"default": 0
					},
					"actionsCompleteAfterTraverse": {
						"type": "boolean",
						"default": false
					}
				}
			},
			"EdgeDeleted": {
				"type": "object",
				"required": [
					"id",
					"deleted"
				],
				"properties": {
					"id": {
						"type": "integer"
					},
					"deleted": {
						"type": "boolean"
					}
				}
			},
			"Poke": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"type": {
						"type": "string",
						"enum": [
							"hit",
							"grab",
							"drag",
							"hoverEnter",
							"hoverLeave"
						],
						"default": "hit"
					},
					"chunkId": {
						"type": "integer",
						"minimum": 0,
						"default": 0,
						"description": "Id of the part of the node's scene geometry poked. 0 for none."
					}
				}
			},
			"Trigger": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"nodeName": {
						"type": "string",
						"description": "Only trigger nodes with this name."
					},
					"nodeType": {
						"type": "string",
						"description": "Only trigger nodes of this type.",
						"enum": [
							"GRAPH_NODE",
							"PING_NODE",
							"SCENE_GEOMETRY_NODE",
							"SCENE_TRANSFORM_NODE",
							"SCRIPT_NODE",
							"SCENE_GEOMETRY_SCRIPT_NODE",
							"SCENE_TRANSFORM_SCRIPT_NODE",
							"SCENE_ROOT_NODE",
							"TELEPORT_NODE",
							"AGENT_NODE",
							"TRIGGER_NODE",
							"SCENE_TEXT_SCRIPT_NODE",
							"BUILDER_SCRIPT_NODE"
						]
					}
				}
			},
			"Animate": {
				"type": "object",
				"required": [
					"animating"
				],
				"additionalProperties": false,
				"properties": {
					"animating": {
						"type": "boolean"
					}
				}
			},
			"Accepted": {
				"type": "object",
				"required": [
					"accepted"
				],
				"properties": {
					"accepted": {
						"const": true
					}
				}
			},
			"StrobePeriod": {
				"type": "object",
				"required": [
					"periodMs"
				],
				"additionalProperties": false,
				"properties": {
					"periodMs": {
						"type": "integer",
						"minimum": 1,
						"description": "Milliseconds between strobes."
					}
				}
			},
			"StrobeEmitter": {
				"type": "object",
				"required": [
					"nodeName",
					"periodMs"
				],
				"properties": {
					"nodeName": {
						"type": "string"
					},
					"periodMs": {
						"type": "integer",
						"minimum": 1
					}
				}
			},
			"StrobeSurface": {
				"type": "object",
				"required": [
					"surfaceName",
					"periodMs"
				],
				"properties": {
					"surfaceName": {
						"type": "string"
					},
					"periodMs": {
						"type": "integer",
						"minimum": 1
					}
				}
			},
			"StrobeCleared": {
				"type": "object",
				"required": [
					"strobing"
				],
				"properties": {
					"nodeName": {
						"type": "string"
					},
					"surfaceName": {
						"type": "string"
					},
					"strobing": {
						"const": false
					}
				}
			}
		},
		"responses": {
			"BadRequest": {
				"description": "The body is missing or is not a JSON object.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/Error"
						},
						"example": {
							"error": {
								"code": "BAD_REQUEST",
								"message": "The body must be a JSON object."
							}
						}
					}
				}
			},
			"Unauthorised": {
				"description": "No valid API token was given.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/Error"
						},
						"example": {
							"error": {
								"code": "UNAUTHORISED",
								"message": "A valid API token is required, as \"Authorization: Bearer <token>\"."
							}
						}
					}
				},
				"headers": {
					"WWW-Authenticate": {
						"schema": {
							"type": "string"
						},
						"description": "Always `Bearer realm=\"matrytsya\"`."
					}
				}
			},
			"NotFound": {
				"description": "The hive, node, surface or edge does not exist.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/Error"
						},
						"example": {
							"error": {
								"code": "NOT_FOUND",
								"message": "No hive named \"Garden\" is running."
							}
						}
					}
				}
			},
			"Conflict": {
				"description": "The request clashes with the hive's current state.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/Error"
						},
						"example": {
							"error": {
								"code": "CONFLICT",
								"message": "A node named \"pinger\" already exists."
							}
						}
					}
				}
			},
			"UnsupportedMediaType": {
				"description": "The body was not sent as JSON.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/Error"
						},
						"example": {
							"error": {
								"code": "UNSUPPORTED_MEDIA_TYPE",
								"message": "A request body must be sent as \"Content-Type: application/json\"."
							}
						}
					}
				}
			},
			"Unprocessable": {
				"description": "The body describes something invalid.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/Error"
						},
						"example": {
							"error": {
								"code": "UNPROCESSABLE",
								"message": "an edge names an action flag that does not exist -- VERSION_GRAPH_ACTION"
							}
						}
					}
				}
			},
			"RateLimited": {
				"description": "Too many failed authentications from this address.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/Error"
						},
						"example": {
							"error": {
								"code": "RATE_LIMITED",
								"message": "Too many requests from this address failed to authenticate. Wait before trying again."
							}
						}
					}
				},
				"headers": {
					"Retry-After": {
						"schema": {
							"type": "integer"
						},
						"description": "Seconds to wait."
					}
				}
			},
			"Internal": {
				"description": "The server failed.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/Error"
						},
						"example": {
							"error": {
								"code": "INTERNAL",
								"message": "The server could not carry out the request."
							}
						}
					}
				}
			}
		}
	}
}
