			"post": {
				"operationId": "createEdge",
				"tags": [
					"Edges"
				],
				"summary": "Add an edge",
				"description": "Adds a directed edge from this node to another node (or to itself). A node holds at most 32 edges.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/EdgeCreate"
							},
