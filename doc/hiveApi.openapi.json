								"example": {
									"name": "Seed",
									"version": 15,
									"nodeCount": 5,
									"persisted": true,
									"surfaces": [
										{
											"name": "seed",
											"path": "/Seed/seed/"
										},
										{
											"name": "structure",
											"path": "/Seed/structure/"
										}
									],
									"strobeEmitters": [
										{
											"nodeName": "root",
											"periodMs": 40
										}
									],
									"strobeSurfaces": [
										{
											"surfaceName": "seed",
											"periodMs": 40
										},
										{
											"surfaceName": "structure",
											"periodMs": 250
										}
