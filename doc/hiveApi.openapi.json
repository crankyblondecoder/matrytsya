			"parameters": [
				{
					"$ref": "#/components/parameters/hive"
				}
			],
			"get": {
				"operationId": "listNodes",
				"tags": [
					"Nodes"
				],
				"summary": "List a hive's nodes",
				"description": "Lists every node with its type and the edges leaving it.",
				"responses": {
					"200": {
						"description": "The hive's nodes.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/NodeList"
								}
							}
						}
					},
