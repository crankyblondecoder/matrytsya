				],
				"summary": "Export a hive's definition",
				"description": "Returns the complete hive definition the running hive would be rebuilt from: each node as it was when it joined the hive, with its edges as they are now, and the hive's surfaces and current strobe registrations. It can be passed to `createHive` (under another name) or saved as a hive file.",
				"responses": {
					"200": {
						"description": "The hive definition.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "hiveSchema.json"
								}
							}
						}
					},
					"401": {
						"$ref": "#/components/responses/Unauthorised"
