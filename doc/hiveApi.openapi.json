			}
		},
		"/hives": {
			"get": {
				"operationId": "listHives",
				"tags": [
					"Hives"
				],
				"summary": "List running hives",
				"description": "Lists every running hive, by name, with its version and how many nodes it holds.",
				"responses": {
					"200": {
						"description": "Running hives, sorted by name.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HiveList"
								},
								"example": {
									"hives": [
										{
											"name": "Seed",
											"version": 15,
											"nodeCount": 5
										}
									]
								}
							}
						}
					},
					"401": {
						"$ref": "#/components/responses/Unauthorised"
					},
					"429": {
						"$ref": "#/components/responses/RateLimited"
					},
					"500": {
						"$ref": "#/components/responses/Internal"
					}
				}
			},
			"post": {
				"operationId": "createHive",
				"tags": [
					"Hives"
				],
				"summary": "Create and start a hive",
				"description": "Builds a hive from a complete hive definition and starts running it. Its surfaces are served straight away, at the paths given in the response.\n\nThe hive is kept in the hive database unless `persist=false`. If the database holds a hive of the same name that is not running, the request is refused rather than overwriting it.",
				"parameters": [
					{
						"name": "persist",
						"in": "query",
						"required": false,
						"schema": {
							"type": "boolean",
							"default": true
						},
						"description": "Whether to keep the hive in the hive database. Ignored when the server has no hive database."
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "hiveSchema.json"
							},
							"example": {
								"name": "Pinger",
								"nodes": [
									{
										"type": "PingNode",
										"name": "a",
										"edges": [
											{
												"toNodeName": "b"
											}
										]
									},
									{
										"type": "PingNode",
										"name": "b"
									}
								]
							}
						}
					},
					"description": "A complete hive definition."
				},
				"responses": {
					"201": {
						"description": "The hive was created and is running.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HiveSummary"
								},
								"example": {
									"name": "Seed",
									"version": 15,
									"nodeCount": 5,
									"persisted": true,
									"surfaces": [
										{
											"name": "seed",
											"path": "/Seed/seed/"
										},
										{
											"name": "structure",
											"path": "/Seed/structure/"
										}
									],
									"strobeEmitters": [
										{
											"nodeName": "root",
											"periodMs": 40
										}
									],
									"strobeSurfaces": [
										{
											"surfaceName": "seed",
											"periodMs": 40
										},
										{
											"surfaceName": "structure",
											"periodMs": 250
										}
									]
								}
							}
						},
						"headers": {
							"Location": {
								"description": "Path of the new hive.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"401": {
						"$ref": "#/components/responses/Unauthorised"
					},
					"429": {
						"$ref": "#/components/responses/RateLimited"
					},
					"500": {
						"$ref": "#/components/responses/Internal"
					},
					"400": {
						"$ref": "#/components/responses/BadRequest"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					},
					"415": {
						"$ref": "#/components/responses/UnsupportedMediaType"
					},
					"422": {
						"$ref": "#/components/responses/Unprocessable"
					}
				}
			}
		},
		"/hives/{hive}": {
			"parameters": [
				{
					"$ref": "#/components/parameters/hive"
				}
			],
			"get": {
				"operationId": "getHive",
				"tags": [
					"Hives"
				],
				"summary": "Summarise a hive",
				"description": "Returns a hive's version, node count, whether it is kept in the hive database, the paths its surfaces are served at, and its strobe registrations.",
