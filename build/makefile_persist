srcFiles = HarnessBuilder.cpp \
HiveBuilder.cpp \
json/JsonHarnessLoader.cpp \
json/JsonHiveLoader.cpp

objFiles = $(srcFiles:.cpp=.o)

CXX = $(cname)
CXXFLAGS = $(cflags)

