{
	"openapi": "3.1.0",
	"info": {
		"title": "Matrytsya hive control API",
		"version": "1",
		"summary": "Build, modify and drive running hives over HTTPS.",
		"description": "Controls the hives a Matrytsya server is running: create and delete whole hives, add, inspect, edit and remove nodes and edges, and drive a hive by poking, triggering and animating its nodes and by setting how often its strobe emitters and surfaces fire.\n\nEvery request must carry an API token as `Authorization: Bearer <token>`. Every request body must be JSON, sent as `Content-Type: application/json`. Every response body is JSON; a failure is always an `Error` object.\n\nNode and hive bodies use exactly the shapes of a hive definition, described by the hive schema served at `/api/v1/hiveSchema.json`. A hive definition fetched from this API can be fed back to it, or loaded by the server from a file, unchanged.\n\nChanges made through this API are kept in the server's hive database, when it has one, just as changes a hive makes to itself are. A hive's version number rises with every structural change, whoever makes it.\n\nA guide to driving this API, written for AI agents, is served at `/api/v1/` as `agentGuide`."
	},
	"servers": [
		{
			"url": "/api/v1",
			"description": "The server this description was fetched from."
		}
	],
	"security": [
		{
			"bearerAuth": []
		}
	],
	"tags": [
		{
			"name": "Discovery",
			"description": "What the API offers and the shapes it uses."
		},
		{
			"name": "Hives",
			"description": "Whole hives: list, create, inspect, export and delete."
		},
		{
			"name": "Nodes",
			"description": "Nodes of a hive: list, add, inspect, edit and remove."
		},
		{
			"name": "Edges",
			"description": "Directed edges from one node to another, which decide where actions travel."
		},
		{
			"name": "Control",
			"description": "Drive a running hive: poke, trigger and animate nodes, and set strobe periods."
		}
	],
	"paths": {
